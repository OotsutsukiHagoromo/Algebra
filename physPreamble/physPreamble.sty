\newcommand*{\makeTitlepageInner}[1][0.5\textwidth]{%
	\hspace*{\fill}%
	\begin{minipage}{#1}
		\begin{tabular}{@{}l@{ }l@{}}
			\multicolumn{2}{@{}l}{\studentName}\\
			\multicolumn{2}{@{}l}{%
				\studentCourse{} курс%
				\ifneedsgroup
					,
					группа \studentGroup
				\fi
			}%
			%\\[1\baselineskip]
			%Отметка: \hrulefill\par
			%\\[1\baselineskip]
			\\
			\ifneedsdates
				Дата выполнения: & \dateStart \\
				Дата составления: & \dateFin
			\fi
		\end{tabular}
		\par
		% \bigskip
		% \hbox to \linewidth {%
		% 	Подпись преподавателя: \hrulefill%
		% }%
		% \medskip
		% \hbox to \linewidth {%
		% 	Подпись студента: \hrulefill%
		% }%
	\end  {minipage}
	\vspace{30pt}%
	\begin{center}
		\bfseries
		\Large
		Лабораторная работа
		\ifthenelse{\equal{\labNum}{}}{}{№~\labNum}%
		%\\[0.5\baselineskip]
		\par
		\medskip
		\large
		<<\labName>>
	\end  {center}%
	\vspace{30pt}%
}
	
