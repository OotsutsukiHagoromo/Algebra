\usepackage{caption}
\DeclareCaptionLabelSeparator{dot}{. }

% #1 is the caption label
% #2 is the separator
% #3 is the text
\DeclareCaptionFormat{mycaptionformat}{%
	#1#2~#3%
}

% #1 is the name (pic, fig, ...)
% #2 is the number
\DeclareCaptionLabelFormat{mycaptionlabelformat}{%
	#1~#2%
}

\captionsetup{%
  %margin=1cm,%
  margin=2\parindent,%
  font=small,%
  labelsep=dot,%
	format=mycaptionformat,%
	labelformat=mycaptionlabelformat,%
	justification=centerlast%
}

\newlength{\picwidth}
\setlength{\picwidth}{\linewidth}
\newlength{\wrappicwidth}
\setlength{\wrappicwidth}{0.4\linewidth}

\newcommand{\insertfigure}[4][\picwidth]{%
	\begin{figure}[h]
		\centering
		\hbox to \linewidth {%
			\hss
			\includegraphics[width=#1]{#2}%
			\hss
		}%
		\caption{#3}
		\label{pic:#4}
	\end{figure}
}

\newcommand*{\insertfigureland}[4][\picwidth]{%
		\begin{landscape}%
			\rule{0pt}{0pt}%
			\vfill
			\setlength{\picwidth}{1\linewidth}%
			\insertfigure[#1]{#2}{#3}{#4}%
			%\par%
			\vfill
			\rule{0pt}{0pt}%
		\end{landscape}%
}

\newcommand*{\insertsvg}[4]{%
	\begin{figure}[h]
		\centering
		\gdef\svgwidth{\picwidth}%
		\input{#1}%
		\par
		\captionof{#4}{#2}
		\label{pic:#3}
	\end{figure}
}

\newcommand*{\insertfigurewrap}[6][]{%
	\begin{wrapfigure}[#1]{#3}{#2\linewidth}%
		\centering
		\includegraphics{#4}%
		\caption{#5}%
		\label{pic:#6}%
	\end{wrapfigure}%
}

\newcommand*{\insertsvgwrap}[7][]{%
	\begin{wrapfigure}[#1]{#3}{#2\linewidth}%
		\centering
		\captionsetup{type=#7}
		%\begin{minipage}{picwidth}
		\gdef\svgwidth{1\linewidth}%
		\input{#4}% \end  {minipage}%
		\par
		%\captionof{#7}{#5}%
		\protect\caption{#5}%
		\label{pic:#6}%
	\end{wrapfigure}%
}

