\newcommand*{\@dv@line}[4]{%
  \ifthenelse{\equal{#1}{}}{%
    #2 #3 / #2 #4%
  }{%
    {#2}^{#1} #3 / #2 {#4}^{#1}%
  }%
}

\newcommand*{\@dv@frac}[4]{%
  \ifthenelse{\equal{#1}{}}{%
    \frac{#2 #3}{#2 #4}%
  }{%
    \frac{{#2}^{#1} #3}{#2 {#4}^{#1}}%
  }%
}

\newcommand*{\pdv@line}[3][]{\@dv@line{#1}{\partial}{#2}{#3}}
\newcommand*{\pdv@frac}[3][]{\@dv@frac{#1}{\partial}{#2}{#3}}
\newcommand*{\ddv@line}[3][]{\@dv@line{#1}{d}{#2}{#3}}
\newcommand*{\ddv@frac}[3][]{\@dv@frac{#1}{d}{#2}{#3}}

\newcommand*{\pdv}{
  \@ifstar\pdv@line\pdv@frac
}

\newcommand*{\ddv}{
  \@ifstar\ddv@line\ddv@frac
}

