\ProvidesPackage{preambleReferences}

% ================================ References =================================

\RequirePackage{hyperref}	% Для ссылок
\hypersetup{%
	breaklinks=true,%
	colorlinks=true,%
	extension=pdf,%
	urlcolor=myurlcolor,%
	linkcolor=mylinkcolor,%
	citecolor=myCiteColor,%
	unicode=true,%
	draft=false,%
	pdfpagemode={},%
	plainpages=false,%
	pdfpagelabels=true,%
	linktocpage=false,%
%	pageanchor=true%
}

